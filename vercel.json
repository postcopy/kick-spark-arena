{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:championship",
  "outputDirectory": "dist-championship",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index-championship.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
